# 复制为 .env（也兼容 .evn），run.ps1启动时载入；已有进程环境变量优先。本示例文件不自动加载。
TRADEFLOW_AGENT_BASE_URL=
TRADEFLOW_AGENT_API_KEY=
TRADEFLOW_AGENT_MODEL=
# 默认 json_schema；不支持该模式的服务可显式配置 json_object，本地仍严格校验字段及引用。
TRADEFLOW_AGENT_RESPONSE_FORMAT=json_schema
# 以下两项可留空，留空时不发送对应服务商参数。
TRADEFLOW_AGENT_THINKING=
TRADEFLOW_AGENT_MAX_TOKENS=
TRADEFLOW_DATA_DIR=data

# 卖方抬头仅在本机设置；未配置模板卖方名单时阻断相关模板制单。
TRADEFLOW_SELLER_NAME=
# JSON数组，配置须与已审核模板的实际卖方一致；不能替代模板版式/哈希适配。
TRADEFLOW_TEMPLATE_SELLER_NAMES=

# HS目录独立于翻译Agent。HSCIQ密钥仅保存在本机环境，不在网页输入。
TRADEFLOW_HS_PROVIDER=hsciq
# 税则平台的hsapi_密钥选tax_rest；HSCIQ主站MCP密钥选mcp，密钥沿用下面一项。
TRADEFLOW_HSCIQ_PROTOCOL=tax_rest
TRADEFLOW_HSCIQ_API_KEY=
